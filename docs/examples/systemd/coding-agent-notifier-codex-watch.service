# Manual copy of the Codex failed-turn watcher unit.
#
# Prefer scripts/install_codex_watch.sh, which fills in the absolute paths,
# reloads systemd, starts the service and enables lingering:
#
#   ./scripts/install_codex_watch.sh                 # install and start
#   ./scripts/install_codex_watch.sh --dry-run       # print the unit only
#   ./scripts/install_codex_watch.sh --uninstall     # stop and remove
#
# To install this file by hand instead, replace /path/to/coding-agent-notifier
# below, copy it to ~/.config/systemd/user/, then:
#   systemctl --user daemon-reload
#   systemctl --user enable --now coding-agent-notifier-codex-watch
#   loginctl enable-linger "$USER"
#
# Logs: journalctl --user -u coding-agent-notifier-codex-watch -f

[Unit]
Description=Coding Agent Notifier - Codex failed-turn watcher
After=default.target

[Service]
Type=simple
WorkingDirectory=/path/to/coding-agent-notifier
ExecStart=/path/to/coding-agent-notifier/.venv/bin/python \
  /path/to/coding-agent-notifier/scripts/notifier/codex_watch.py \
  --env-file /path/to/coding-agent-notifier/.env \
  --interval 30
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
